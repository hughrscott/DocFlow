#!/bin/bash
# DocFlow — start, stop, restart, status
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
PIDFILE="$HOME/.docflow/docflow.pid"
LOGFILE="$DIR/logs/docflow.log"
ERRFILE="$DIR/logs/docflow.err"
PORT=8765

mkdir -p "$HOME/.docflow" "$DIR/logs"

_is_running() {
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PIDFILE"
    fi
    return 1
}

cmd_start() {
    if _is_running; then
        echo "DocFlow is already running (PID $(cat "$PIDFILE"))"
        echo "  http://localhost:$PORT"
        return 0
    fi

    # Kill anything on the port
    lsof -ti :"$PORT" 2>/dev/null | xargs kill 2>/dev/null || true

    echo "Starting DocFlow..."
    /usr/bin/arch -arm64 "$DIR/.venv/bin/python" "$DIR/main.py" \
        --config "$DIR/config/user_config.yaml" \
        ui --port "$PORT" \
        >>"$LOGFILE" 2>>"$ERRFILE" &

    local pid=$!
    echo "$pid" > "$PIDFILE"

    # Wait and verify
    sleep 2
    if kill -0 "$pid" 2>/dev/null; then
        echo "DocFlow is running (PID $pid)"
        echo "  http://localhost:$PORT"
    else
        rm -f "$PIDFILE"
        echo "Failed to start. Check logs:"
        echo "  $ERRFILE"
        exit 1
    fi
}

cmd_stop() {
    if ! _is_running; then
        echo "DocFlow is not running"
        # Clean up any orphan on the port
        lsof -ti :"$PORT" 2>/dev/null | xargs kill 2>/dev/null || true
        return 0
    fi

    local pid
    pid=$(cat "$PIDFILE")
    echo "Stopping DocFlow (PID $pid)..."
    kill "$pid" 2>/dev/null || true

    # Wait for clean shutdown
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
        sleep 0.5
        i=$((i + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$PIDFILE"
    echo "Stopped"
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_status() {
    if _is_running; then
        echo "DocFlow is running (PID $(cat "$PIDFILE"))"
        echo "  http://localhost:$PORT"
    else
        echo "DocFlow is not running"
    fi
}

cmd_logs() {
    tail -f "$LOGFILE" "$ERRFILE"
}

case "${1:-}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    *)
        echo "Usage: docflow {start|stop|restart|status|logs}"
        echo ""
        echo "  start    Start DocFlow on port $PORT"
        echo "  stop     Stop DocFlow"
        echo "  restart  Restart DocFlow"
        echo "  status   Check if DocFlow is running"
        echo "  logs     Tail the log files"
        exit 1
        ;;
esac
